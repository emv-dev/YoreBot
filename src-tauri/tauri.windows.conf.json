{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YoreBot",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "center": true,
        "hiddenTitle": true,
        "transparent": true,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": ["fullScreenUI", "mica", "tabbed", "blur", "acrylic"],
          "state": "active"
        },
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --proxy-server=http://127.0.0.1:9 --proxy-bypass-list=localhost,127.0.0.1,[::1],tauri.localhost,asset.localhost,ipc.localhost"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "resources": ["resources/pre-install/**/*", "resources/LICENSE", "resources/stop-yorebot-owned-processes.ps1", "resources/agent-skills/downloads-organizer/**/*", "resources/bin/jan-cli.exe", "resources/llamacpp-backend-upstream/**/*"],
    "externalBin": ["resources/bin/bun", "resources/bin/uv"],
    "windows": {
      "wix": {
        "upgradeCode": "f9861bdd-4a50-467e-ad25-c14c81803a3a"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
